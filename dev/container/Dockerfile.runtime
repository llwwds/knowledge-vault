# Headless local service image; Ollama hosts BGE-M3, avoiding PyTorch/CUDA here.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    HF_HUB_DISABLE_TELEMETRY=1

RUN pip install --no-cache-dir uv \
    && uv pip install --system "zvec>=0.7.0" "jieba>=0.42.1" "numpy>=2.0"
WORKDIR /app
COPY src/ ./src/
COPY scripts/ ./scripts/
EXPOSE 8770
ENTRYPOINT ["python", "-m", "knowledge_vault.cli", "kv-serve", "--host", "0.0.0.0", "--port", "8770"]
